function checkArenaExists(arena: string) :: boolean:
	if yaml node keys "arenas" from "config" contains {_arena}:
		return true
	else:
		return false
command /t:
	trigger:
		delete {hideandseek::status}
		delete {hideandseek::current_map}
		# teleport player to yaml value "arenas.Test.spawnpoint" from "config"
		# set {_ss} to yaml value "arenas.Test.spawnpoint" from "config"
