options:
	# prefix: &dHide &band &dSeek&r
	# prefix: &5[&dHide &3and &dSeek&5]&r
	prefix: &l&6Hide &eand &6Seek&r
	block_selection_timer: 10
	hiding_timer: 10
	game_timer: 200
	amount_of_seekers: 2
on load:
	load yaml "plugins/HideAndSeek/config.yml" as "config"


on tab complete of "/hideandseek" or "/hs":
	set tab completions for position 1 to "setplayers", "game", "arena" and "reload"
	if tab arg-1 is "game":
		set tab completions for position 2 to "selectmap" and "start"
		if tab arg-2 is "selectmap":
			set tab completions for position 3 to yaml node keys "arenas" from "config"
	if tab arg-1 is "arena":
		set tab completions for position 2 to "create", "remove", "list" and "setup_arena"
		if tab arg-2 is "create":
			set tab completions for position 3 to "MyArenaName"
		if tab arg-2 is "remove":
			set tab completions for position 3 to yaml node keys "arenas" from "config"
		if tab arg-2 is "setup_arena":
			set tab completions for position 3 to yaml node keys "arenas" from "config"
			set tab completions for position 4 to "arena_pos1", "arena_pos2" and "spawnpoint"
command /hideandseek [<string>] [<string>] [<string>] [<string>]:
	usage: {@prefix}: Use hideandseek /help to get the command list!
	permission: hideandseek.admin
	permission message: {@prefix}: You don't have permission to execute this command
	aliases: /hs
	executable by: players
	trigger:
		if arg-1 is "setplayers":
			set {hideandseek::players::*} to all players
			send "{@prefix}: %size of {hideandseek::players::*}% player/s added to the game." to player
		if arg-1 is "game":
			if arg-2 is "selectmap":
				if all:
					arg-3 is set
					yaml node keys "arenas" from "config" contains arg-3
				then:
					set {hideandseek::current_map} to arg-3
			if arg-2 is "start":
				if size of {hideandseek::players::*} > 0:
					if all:
						{hideandseek::current_map} is set
						yaml node keys "arenas" from "config" contains {hideandseek::current_map}
					then:
						if {hideandseek::status} isn't "started":
							set {_map_spawnpoint} to yaml value "arenas.%{hideandseek::current_map}%.spawnpoint" from "config"
							teleport {hideandseek::players::*} to {_map_spawnpoint}
							start_game()
							send "{@prefix}: Game started!" to player
						else:
							send "{@prefix}: &cGame already started!" to player
					else:
						send "{@prefix}: &cArena not found, use &n/hs game selectmap <arena>&r&c to select a new one!" to player
				else:
					send "{@prefix}: &cYou need to add at least 2 players, use &n/hs setplayers&r&c!" to player
		if arg-1 is "arena": 
			if arg-2 is "create":
				if arg-3 is set:
					set {_arena_name} to arg-3
					replace all " " , "&" , "/" , "#" , "$" , "," , "(" , ")" , "=" , "?" , "¿" and "." with "_" in {_arena_name}
					set yaml value "arenas.%{_arena_name}%.display_name" from "config" to {_arena_name}
					save yaml "config"
					send "{@prefix}: Arena &n%arg-3%&r has been added to the configuration!" to player
				else:
					send "{@prefix}: &cYou must input any text to create an arena!" to player
			else if arg-2 is "remove":
				if size of yaml node keys "arenas" from "config" > 0:
					if all:
						arg-3 is set
						yaml node keys "arenas" from "config" contains arg-3
					then:
						delete yaml list "arenas.%arg-3%" from "config"
						save yaml "config"
						send "{@prefix}: Arena &n%arg-3%&r removed from the config!" to player 
					else:
						send "{@prefix}: &cYou must input an arena name!" to player
				else:
					send "{@prefix}: &cThere are no arenas to remove!" to player
			else if arg-2 is "list":
				loop yaml node keys "arenas" from "config":
					add loop-value to {_arenas_list::*}
				send "{@prefix}: Available arenas:" to player
				send "&31.&r %the 1st element out of {_arenas_list::*}%" to player if (the 1st element out of {_arenas_list::*} is set)
				send "&32.&r %the 2nd element out of {_arenas_list::*}%" to player if (the 2nd element out of {_arenas_list::*} is set)
				send "&33.&r %the 3rd element out of {_arenas_list::*}%" to player if (the 3rd element out of {_arenas_list::*} is set)
				send "&34.&r %the 4th element out of {_arenas_list::*}%" to player if (the 4th element out of {_arenas_list::*} is set)
				send "&35.&r %the 5th element out of {_arenas_list::*}%" to player if (the 5th element out of {_arenas_list::*} is set)
				send "&36.&r %the 6th element out of {_arenas_list::*}%" to player if (the 6th element out of {_arenas_list::*} is set)
				send "&37.&r %the 7th element out of {_arenas_list::*}%" to player if (the 7th element out of {_arenas_list::*} is set)
				send "&38.&r %the 8th element out of {_arenas_list::*}%" to player if (the 8th element out of {_arenas_list::*} is set)
			else if arg-2 is "setup_arena":
				set {_location} to player's location
				if arg-4 is "arena_pos1":
					set yaml value "arenas.%arg-3%.pos1" from "config" to {_location}
					set yaw of yaml value "arenas.%arg-3%.pos1" from "config" to 0
					set pitch of yaml value "arenas.%arg-3%.pos1" from "config" to 0
					save yaml "config"
					send "{@prefix}: Arena position 1 set to x:%{_location}'s x-coord%, y:%{_location}'s y-coord%, z:%{_location}'s z-coord%!" to player
				else if arg-4 is "arena_pos2":
					set yaml value "arenas.%arg-3%.pos2" from "config" to {_location}
					set yaw of yaml value "arenas.%arg-3%.pos2" from "config" to 0
					set pitch of yaml value "arenas.%arg-3%.pos2" from "config" to 0
					save yaml "config"
					send "{@prefix}: Arena position 2 set to x:%{_location}'s x-coord%, y:%{_location}'s y-coord%, z:%{_location}'s z-coord%!" to player
				else if arg-4 is "spawnpoint":
					set yaml value "arenas.%arg-3%.spawnpoint" from "config" to {_location}
					set yaw of yaml value "arenas.%arg-3%.spawnpoint" from "config" to 0
					set pitch of yaml value "arenas.%arg-3%.spawnpoint" from "config" to 0
					save yaml "config"
					send "{@prefix}: Arena spawn point set to x:%{_location}'s x-coord%, y:%{_location}'s y-coord%, z:%{_location}'s z-coord%!" to player
		if arg-1 is "reload":
			unload yaml "config"
			load yaml "plugins/HideAndSeek/config.yml" as "config"
			send "{@prefix}: All data reloaded!" to player


every tick:
	loop all players:
		set title of loop-value's scoreboard to "{@prefix}"
		set line 1 of loop-value's scoreboard to "{hideandseek::status}: %{hideandseek::status}%"
		set line 1 of loop-value's scoreboard to "{hideandseek::timer::phase}: %{hideandseek::timer::phase}%"
		set line 1 of loop-value's scoreboard to "{hideandseek::block_selection_timer}: %{hideandseek::block_selection_timer}%"
		set line 1 of loop-value's scoreboard to "{hideandseek::hiding_timer}: %{hideandseek::hiding_timer}%"
		set line 1 of loop-value's scoreboard to "{hideandseek::game_timer}: %{hideandseek::game_timer}%"
		if {hideandseek::timer::phase} is 0:
			set line 1 of loop-value's scoreboard to "Selection time:"
			set line 2 of loop-value's scoreboard to "- %{hideandseek::block_selection_timer}%"
		if {hideandseek::timer::phase} is 1:
			set line 1 of loop-value's scoreboard to "Selection time:"
			set line 2 of loop-value's scoreboard to "- %{hideandseek::block_selection_timer}%"
		if {hideandseek::timer::phase} is 2:
			set line 1 of loop-value's scoreboard to "Selection time:"
			set line 2 of loop-value's scoreboard to "- %{hideandseek::block_selection_timer}%"

every 1 second:
	if {hideandseek::status} is "started":
		if {hideandseek::timer::phase} is 0:
			if {hideandseek::block_selection_timer} > 0:
				remove 1 from {hideandseek::block_selection_timer}
			else if {hideandseek::block_selection_timer} <= 0:
				set {hideandseek::timer::phase} to 1

		if {hideandseek::timer::phase} is 1:
			if {hideandseek::hiding_timer} > 1:
				remove 1 from {hideandseek::hiding_timer}
			else if {hideandseek::hiding_timer} <= 1:
				set {hideandseek::timer::phase} to 2
				
		if {hideandseek::timer::phase} is 2:
			if {hideandseek::game_timer} > 2:
				remove 1 from {hideandseek::game_timer}
			else if {hideandseek::game_timer} <= 2:
				set {hideandseek::timer::phase} to 3

	# {hideandseek::block_selection_timer}
	# {hideandseek::hiding_timer}
	# {hideandseek::game_timer}

	# block_selection_timer: 10
	# hiding_timer: 10
	# game_timer: 200
#TODO: Finish  timer code
#TODO: Hacer que el phase timer controle dos timers separados 1 para esconderse y otro que sea el timer del juego (aqui iria el timer del ciclo del juego en si y de la seleccion de bloques)
#-################################################################################################################
#-================================================================================================================
#Functions
#-================================================================================================================
#-################################################################################################################
function start_timer():
	set {hideandseek::timer::phase} to 0
	set {hideandseek::block_selection_timer} to {@block_selection_timer}
	set {hideandseek::hiding_timer} to {@hiding_timer}
	set {hideandseek::game_timer} to {@game_timer}


function start_game():
	set {hideandseek::players::*} to "a", "b", "c", "d", "e", "f", "g" and "h" #all players
	loop 2 times:
		set {hideandseek::players::seekers::*} to a random element of {hideandseek::players::*}
		remove {hideandseek::players::seekers::*}  from {hideandseek::players::*}
	start_timer():

function check_game_config() :: boolean:
	set {_return} to true
	if {@game_timer} isn't greater than {@hiding_timer}:
		set {_return} to false
	return {_return}

function checkArenaExists(arena: string) :: boolean:
	if yaml node keys "arenas" from "config" contains {_arena}:
		return true
	else:
		return false
command /t:
	trigger:
		delete {hideandseek::status}
		delete {hideandseek::current_map}
		# teleport player to yaml value "arenas.Test.spawnpoint" from "config"
		# set {_ss} to yaml value "arenas.Test.spawnpoint" from "config"
		# broadcast "'type: %{_ss}'s type%"
		# broadcast "type: %type of {_ss}%"
		# broadcast "ss: %{_ss}%"
	# 	broadcast "Exists: %checkArenaExists(arg-1)%"
	# 	broadcast "Configured: %checkArenaConfigured(arg-1)%"
		# broadcast "pos1: %yaml value "arenas.%arg-1%.pos1" from "config"%"
		# broadcast "pos2: %yaml value "arenas.%arg-1%.pos2" from "config"%"
		# broadcast "spawnpoint: %yaml value "arenas.%arg-1%.spawnpoint""" from "config"%"
function checkArenaConfigured(arena: string) :: boolean: #TODO: FIX THE CHECK; BECAUSE IT DOESN'T DETECT ANYTHING AS SET
	set {_allConfigured} to true
	if checkArenaExists({_arena}) is true:
		broadcast "asd"
		if yaml value "arenas.%{_arena}%.pos1" from "config" exists:
			broadcast "&2si1"
			if type of (yaml value "arenas.%{_arena}%.pos1" from "config") is location:
				broadcast "&2si2"
			else:
				set {_allConfigured} to false
		else:
			set {_allConfigured} to false
		if yaml value "arenas.%{_arena}%.pos2" from "config" exists:
			broadcast "&csi1"
			if type of (yaml value "arenas.%{_arena}%.pos2" from "config") is location:
				broadcast "&csi2"
			else:
				set {_allConfigured} to false
		else:
			set {_allConfigured} to false
		if yaml value "arenas.%{_arena}%.spawnpoint" from "config" exists:
			broadcast "&esi1"
			if type of (yaml value "arenas.%{_arena}%.spawnpoint" from "config") is location:
				broadcast "&esi2"
			else:
				set {_allConfigured} to false
		else:
			set {_allConfigured} to false
	return {_allConfigured}



